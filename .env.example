# ===== خادم الويب =====
HOST=0.0.0.0
PORT=8787
# رمز اختياري لحماية الواجهة (اتركه فارغاً للتعطيل)
WEB_TOKEN=

# ===== مساحة العمل =====
# المجلد الذي يعمل فيه الوكيل
WORKSPACE=/home/asus
# مجلد إعدادات Pi (auth.json / models)
PI_AGENT_DIR=/home/asus/.pi/agent

# ===== النموذج الافتراضي =====
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-flash
# off | minimal | low | medium | high | xhigh | max
DEFAULT_THINKING=medium

# ===== تيليجرام =====
# ضع توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=
# قائمة معرّفات المستخدمين المسموح لهم (فارغة = الجميع)
TELEGRAM_ALLOWED_USERS=
# قائمة معرّفات المحادثات المسموح لها (فارغة = الجميع)
TELEGRAM_ALLOWED_CHATS=
# مهلة تحديث رسالة البث المباشر بالمللي ثانية
TELEGRAM_STREAM_THROTTLE_MS=1200
# وضع الإشعارات (المرحلة D1):
#   final   = رسالة واحدة «⏳ جارٍ العمل…» تُستبدل بالنتيجة النهائية فقط (الافتراضي)
#   compact = رسالة واحدة حيّة بسطر تقدّم قصير (حد 6 أسطر) ثم النتيجة النهائية
#   live    = البث المباشر الكامل (السلوك القديم)
TELEGRAM_NOTIFY_MODE=final

# ===== سلوك الوكيل =====
# تعطيل الإضافات الخارجية لتسريع البدء: true | false
PI_NO_EXTENSIONS=false
PI_NO_SKILLS=false
# قائمة أدوات مسموحة (فارغة = الافتراضية) مثال: read,ls,grep,find,bash
PI_TOOLS=
# تعليمات إضافية تُلحق بموجّه النظام
PI_SYSTEM_PROMPT_EXTRA=

# ===== جسر RPC (المرحلة A) =====
# 1 = تشغيل الجلسات عبر `pi --mode rpc`، و0/فارغ = المسار القديم عبر SDK
FEATURE_RPC=0
# مسار CLI صريح (اختياري؛ يُحلّ تلقائياً من حزمة pi)
# PI_CLI_PATH=/home/user/.pi/agent/install/releases/1.3.0/node_modules/@earendil-works/pi-coding-agent/dist/cli.js
# معاملات إضافية تُمرّر إلى `pi --mode rpc` (مفصولة بمسافات)
PI_RPC_EXTRA_ARGS=

# ===== موافقة الأدوات (المرحلة C2) =====
# off = تعطيل، dangerous = bash/write/edit/mcp__* فقط (الافتراضي)، all = كل أداة
APPROVAL_MODE=dangerous
# مهلة حوار الموافقة بالمللي ثانية ثم رفض آمن
APPROVAL_TIMEOUT_MS=120000
# 1 = اسمح عند غياب واجهة المستخدم/فشل الحوار (غير آمن؛ الافتراضي رفض)
APPROVAL_FAIL_OPEN=0
# ملف قواعد «سماح دائماً» (اختياري؛ الافتراضي data/approvals.json)
# PI_APPROVALS_FILE=/path/to/approvals.json

# ===== لغة الواجهة =====
# ar | en
BOT_LANGUAGE=ar

# ===== مزامنة الويب وتيليجرام =====
# جلسة واحدة مشتركة بين الواجهة وتيليجرام (اتركها فارغة لتعطيل المزامنة)
SHARED_SESSION_ID=shared:main
SYNC_WEB_TELEGRAM=true

# ===== التفويض (delegate) =====
# true | false — تعطيل أداة تفويض الوكلاء نهائياً
DELEGATE_ENABLED=true
# مهلة الوكيل الفرعي بالمللي ثانية (افتراضي 5 دقائق = 300000)
DELEGATE_TIMEOUT_MS=300000
