# ===== خادم الويب =====
HOST=0.0.0.0
PORT=8787
# رمز اختياري لحماية الواجهة (اتركه فارغاً للتعطيل)
WEB_TOKEN=

# ===== مساحة العمل =====
# المجلد الذي يعمل فيه الوكيل
WORKSPACE=/home/asus
# مجلد إعدادات Pi (auth.json / models)
PI_AGENT_DIR=/home/asus/.pi/agent

# ===== النموذج الافتراضي =====
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-flash
# off | minimal | low | medium | high | xhigh | max
DEFAULT_THINKING=medium

# ===== تيليجرام =====
# ضع توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=
# قائمة معرّفات المستخدمين المسموح لهم (فارغة = الجميع)
TELEGRAM_ALLOWED_USERS=
# قائمة معرّفات المحادثات المسموح لها (فارغة = الجميع)
TELEGRAM_ALLOWED_CHATS=
# مهلة تحديث رسالة البث المباشر بالمللي ثانية
TELEGRAM_STREAM_THROTTLE_MS=1200

# ===== سلوك الوكيل =====
# تعطيل الإضافات الخارجية لتسريع البدء: true | false
PI_NO_EXTENSIONS=false
PI_NO_SKILLS=false
# قائمة أدوات مسموحة (فارغة = الافتراضية) مثال: read,ls,grep,find,bash
PI_TOOLS=
# تعليمات إضافية تُلحق بموجّه النظام
PI_SYSTEM_PROMPT_EXTRA=

# ===== لغة الواجهة =====
# ar | en
BOT_LANGUAGE=ar

# ===== مزامنة الويب وتيليجرام =====
# جلسة واحدة مشتركة بين الواجهة وتيليجرام (اتركها فارغة لتعطيل المزامنة)
SHARED_SESSION_ID=shared:main
SYNC_WEB_TELEGRAM=true
