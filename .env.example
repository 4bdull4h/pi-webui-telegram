# ===== الهوية / Identity =====
# الاسم الذي يظهر في الواجهة والبوت (اتركه فارغاً للافتراضي)
# Display name used by the web UI and the bot (empty = default)
ASSISTANT_NAME=
# معرّف الدعم الظاهر في /help (اختياري)
# Support handle shown in /help (optional)
SUPPORT_HANDLE=@coder480
# ar | en
BOT_LANGUAGE=ar

# ===== خادم الويب / Web server =====
HOST=0.0.0.0
PORT=8787
# رمز اختياري لحماية الواجهة (اتركه فارغاً للتعطيل)
# Optional access token for the web UI (empty = disabled)
WEB_TOKEN=

# ===== مساحة العمل / Workspace =====
# المجلد الذي يعمل فيه الوكيل (فارغ = مجلد المستخدم)
# Agent workspace directory (empty = home directory)
WORKSPACE=
# مجلد إعدادات Pi (فارغ = ~/.pi/agent)
# Pi agent settings directory (empty = ~/.pi/agent)
PI_AGENT_DIR=

# ===== النموذج الافتراضي / Default model =====
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-flash
# off | minimal | low | medium | high | xhigh | max
DEFAULT_THINKING=medium

# ===== تيليجرام / Telegram =====
# ضع توكن البوت من @BotFather (اتركه فارغاً لتعطيل البوت)
# Bot token from @BotFather (empty = bot disabled)
TELEGRAM_BOT_TOKEN=
# معرّف المستخدمين المسموح لهم، مفصولاً بفواصل. فارغ = رفض الجميع (آمن).
# Allowed Telegram user IDs, comma-separated. Empty = deny everyone (fail-closed).
TELEGRAM_ALLOWED_USERS=
# معرّف المحادثات المسموح لها، مفصولاً بفواصل. فارغ = رفض الجميع.
# Allowed Telegram chat IDs, comma-separated. Empty = deny everyone.
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_STREAM_THROTTLE_MS=1200
# final | compact | live
TELEGRAM_NOTIFY_MODE=final

# ===== ميزات / Features =====
SYNC_WEB_TELEGRAM=true
FEATURE_RPC=false
# تعطيل الإضافات الخارجية لتسريع البدء / Disable external extensions for faster startup
PI_NO_EXTENSIONS=false
# تعطيل المهارات / Disable skills
PI_NO_SKILLS=false
# قائمة أدوات مسموحة (فارغة = الكل) / Allowed tools (empty = all)
PI_TOOLS=
# تعليمات إضافية تُلحق بموجّه النظام / Extra system prompt text
PI_SYSTEM_PROMPT_EXTRA=
# أداة تفويض الوكلاء / Sub-agent delegation
DELEGATE_ENABLED=true
DELEGATE_TIMEOUT_MS=300000
